# =====================================================================
# Cấu hình backend Cổng Một cửa điện tử TBU — sao chép thành `.env`
# KHÔNG commit tệp `.env` thật (đã bị .gitignore chặn).
# =====================================================================

# --- Cơ sở dữ liệu ---------------------------------------------------
# Khớp service `postgres` trong docker-compose.yml ở thư mục gốc dự án.
# Cổng 5433 để không đụng PostgreSQL cục bộ (nếu có) đang dùng 5432.
DATABASE_URL="postgresql://motcua:motcua@localhost:5433/motcua?schema=public"

# --- Ứng dụng --------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=8080

# --- Xác thực / phiên ------------------------------------------------
# BẮT BUỘC đổi khi triển khai thật: chuỗi ngẫu nhiên >= 32 ký tự.
# Backend TỪ CHỐI khởi động ở NODE_ENV=production nếu vẫn là giá trị mặc định.
JWT_SECRET="doi-chuoi-nay-truoc-khi-trien-khai-<32+-ky-tu-ngau-nhien>"
# Thời hạn access token (dạng 15m / 1h / 7d)
JWT_ACCESS_TTL=15m
# Thời hạn refresh token (bị xoay vòng mỗi lần dùng)
JWT_REFRESH_TTL=7d

# --- Miền công khai & CORS ------------------------------------------
# Dùng để sinh liên kết QR xác thực văn bản.
PUBLIC_DOMAIN="http://localhost:5173"
# Tên mới tương đương PUBLIC_DOMAIN, được ưu tiên nếu đặt.
# PUBLIC_BASE_URL="http://localhost:5173"
# Danh sách origin được phép CORS, phân tách bằng dấu phẩy.
CORS_ORIGINS="http://localhost:5173"

# --- Ghi log --------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- OTP email (chỉ cần khi OTP_CHANNEL=EMAIL) ----------------------
# SMTP_HOST=smtp.example.edu.vn
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.edu.vn

# --- Giới hạn tần suất ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Riêng nhóm /auth/* (đăng nhập, làm mới token) siết chặt hơn.
AUTH_RATE_LIMIT_MAX=20

# --- Trình diễn / vận hành ------------------------------------------
# Bật `POST /api/v1/auth/quick-login` (đăng nhập nhanh theo vai trò).
# Chỉ bật ở môi trường demo; mặc định tắt (endpoint trả 404).
ENABLE_QUICK_LOGIN=false

# Số phút hiệu lực của liên kết tải văn bản có chữ ký (quyết định B3).
SIGNED_URL_TTL_MINUTES=5

# --- Chatbot AI (Giai �o?n chatbot) ---------------------------------
# L?y kho� mi?n ph� t?i Google AI Studio (https://aistudio.google.com/apikey)
# v� �?t GEMINI_API_KEY trong .env (KH�NG commit, KH�NG ��a v�o frontend).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Ng�?ng �i?m truy xu?t t?i thi?u tr�?c khi tr? l?i.
CHAT_MIN_SCORE=0.6
# Gi?i h?n theo ng�?i d�ng v� to�n h? th?ng.
CHAT_USER_PER_10MIN=15
CHAT_USER_PER_DAY=80
CHAT_GLOBAL_PER_DAY=1000
# S? c�u chuy?n l�n c�n b? t?i �a m?i ng�?i/ng�y.
CHAT_HANDOFF_PER_DAY=5
# S? ng�y gi? l?ch s? tin nh?n.
CHAT_RETENTION_DAYS=90
