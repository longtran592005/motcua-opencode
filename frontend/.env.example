# Bật/tắt lớp dữ liệu giả lập. true = dùng mockXxxService, false = gọi backend thật.
VITE_USE_MOCK=true
# Khi VITE_USE_MOCK=false, chỉ các nhóm dưới đây gọi backend thật.
# VITE_REAL_SERVICES=auth,applications,approvals,otp,verify,documents,notifications,catalog,admin,library

# Địa chỉ API backend khi VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8080/api

# Thời gian trễ giả lập của mock (ms)
VITE_MOCK_DELAY_MIN=300
VITE_MOCK_DELAY_MAX=600

# Tỉ lệ lỗi ngẫu nhiên của mock (0 - 1) để kiểm tra giao diện lỗi
VITE_MOCK_ERROR_RATE=0.04
