model Signature {
  id              String          @id @default(uuid()) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  vanBanId        String?         @map("van_ban_id") @db.Uuid
  buocOrder       Int             @map("buoc_order")
  tenBuoc         String          @map("ten_buoc")
  nguoiKyId       String          @map("nguoi_ky_id") @db.Uuid
  hoTen           String          @map("ho_ten")
  chucVu          String?         @map("chuc_vu")
  vaiTro          Role            @map("vai_tro")
  phuongThuc      SignatureMethod @map("phuong_thuc")
  thoiDiemKy      DateTime        @map("thoi_diem_ky")
  maBam           String          @map("ma_bam") // SHA-256 ná»™i dung táº¡i thá»i Ä‘iá»ƒm kĂ½
  maChuKy         String          @map("ma_chu_ky")
  hopLe           Boolean         @default(true) @map("hop_le")
  lyDoKhongHopLe  String?         @map("ly_do_khong_hop_le")
  /** Nhà cung cấp chữ ký đã ký (INTERNAL_HMAC | RSA_SHA256). */
  provider        String?         @map("provider")
  createdAt       DateTime        @default(now()) @map("created_at")

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  nguoiKy     User             @relation("SignatureSigner", fields: [nguoiKyId], references: [id])
  vanBan      SignedDocument?  @relation(fields: [vanBanId], references: [id])

  @@index([applicationId, buocOrder])
  @@index([vanBanId])
  @@map("signatures")
}

model OtpChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  stepOrder     Int       @map("step_order")
  otpHash       String    @map("otp_hash") // chá»‰ lÆ°u bÄƒm, KHĂ”NG bao giá» lÆ°u mĂ£ thĂ´
  hetHanLuc     DateTime  @map("het_han_luc")
  soLanThu      Int       @default(0) @map("so_lan_thu")
  soLanConLai   Int       @default(5) @map("so_lan_con_lai")
  khoaDenLuc    DateTime? @map("khoa_den_luc")
  daDung        Boolean   @default(false) @map("da_dung")
  lastSentAt    DateTime  @default(now()) @map("last_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, applicationId])
  @@index([hetHanLuc])
  @@map("otp_challenges")
}

