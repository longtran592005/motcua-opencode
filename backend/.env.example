# =====================================================================
# Cấu hình backend Cổng Một cửa điện tử TBU — sao chép thành `.env`
# KHÔNG commit tệp `.env` thật (đã bị .gitignore chặn).
# =====================================================================

# --- Cơ sở dữ liệu ---------------------------------------------------
# Khớp service `postgres` trong docker-compose.yml ở thư mục gốc dự án.
# Cổng 5433 để không đụng PostgreSQL cục bộ (nếu có) đang dùng 5432.
DATABASE_URL="postgresql://motcua:motcua@localhost:5433/motcua?schema=public"

# --- Ứng dụng --------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=8080

# --- Xác thực / phiên ------------------------------------------------
# BẮT BUỘC đổi khi triển khai thật: chuỗi ngẫu nhiên >= 32 ký tự.
# Backend TỪ CHỐI khởi động ở NODE_ENV=production nếu vẫn là giá trị mặc định.
JWT_SECRET="doi-chuoi-nay-truoc-khi-trien-khai-<32+-ky-tu-ngau-nhien>"
# Thời hạn access token (dạng 15m / 1h / 7d)
JWT_ACCESS_TTL=15m
# Thời hạn refresh token (bị xoay vòng mỗi lần dùng)
JWT_REFRESH_TTL=7d

# --- Miền công khai & CORS ------------------------------------------
# Dùng để sinh liên kết QR xác thực văn bản.
PUBLIC_DOMAIN="http://localhost:5173"
# Danh sách origin được phép CORS, phân tách bằng dấu phẩy.
CORS_ORIGINS="http://localhost:5173"

# --- Ghi log --------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Giới hạn tần suất ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Riêng nhóm /auth/* (đăng nhập, làm mới token) siết chặt hơn.
AUTH_RATE_LIMIT_MAX=20

# --- Trình diễn / vận hành ------------------------------------------
# Bật `POST /api/v1/auth/quick-login` (đăng nhập nhanh theo vai trò).
# Chỉ bật ở môi trường demo; mặc định tắt (endpoint trả 404).
ENABLE_QUICK_LOGIN=false

# Số phút hiệu lực của liên kết tải văn bản có chữ ký (quyết định B3).
SIGNED_URL_TTL_MINUTES=5
