model DocumentTemplate {
  id         String    @id @default(uuid()) @db.Uuid
  ma         String    @unique @map("ma")
  ten        String    @map("ten")
  loaiVanBan String    @map("loai_van_ban")
  noiDung    String    @map("noi_dung") // chá»©a biáº¿n {{ho_ten}}, {{mssv}}...
  hoatDong   Boolean   @default(true) @map("hoat_dong")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  requestTypes RequestType[]

  @@index([deletedAt])
  isDemo   Boolean   @default(false) @map("is_demo")

  @@map("document_templates")
}

model SignedDocument {
  id               String         @id @default(uuid()) @db.Uuid
  soVanBan         String         @unique @map("so_van_ban")
  trichYeu         String         @map("trich_yeu")
  loaiVanBan       String         @map("loai_van_ban")
  templateId       String?        @map("template_id") @db.Uuid
  applicationId    String         @unique @map("application_id") @db.Uuid
  sinhVienSnapshot Json           @map("sinh_vien_snapshot")
  noiDung          String         @map("noi_dung")
  ngayCap          DateTime       @default(now()) @map("ngay_cap")
  tokenXacThuc     String         @unique @map("token_xac_thuc") // >= 128 bit
  maBamSha256      String         @map("ma_bam_sha256") // SHA-256 tá»‡p PDF nhá»‹ phĂ¢n
  pdfStorageKey    String?        @map("pdf_storage_key")
  trangThai        DocumentStatus @default(VALID) @map("trang_thai")
  chuKyConHieuLuc  Boolean        @default(true) @map("chu_ky_con_hieu_luc")
  lyDoThuHoi       String?        @map("ly_do_thu_hoi")
  ngayThuHoi       DateTime?      @map("ngay_thu_hoi")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  signatures  Signature[]
  downloads   DocumentDownload[]

  @@index([trangThai])
  @@index([ngayCap])
  @@index([deletedAt])
  @@index([isDemo])
  isDemo   Boolean   @default(false) @map("is_demo")

  @@map("signed_documents")
}

model DocumentDownload {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  nguoiTaiId   String?  @map("nguoi_tai_id") @db.Uuid
  nguoiTaiTen  String   @map("nguoi_tai_ten")
  diaChiIp     String   @map("dia_chi_ip")
  userAgent    String?  @map("user_agent")
  mucDich      String?  @map("muc_dich") // 'export' | 'download'
  createdAt    DateTime @default(now()) @map("created_at")

  document SignedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  nguoiTai User?          @relation("DownloadUser", fields: [nguoiTaiId], references: [id])

  @@index([documentId, createdAt])
  isDemo   Boolean   @default(false) @map("is_demo")

  @@map("document_downloads")
}

